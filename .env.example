# ── Supabase ──────────────────────────────────────────────────────────────
# Project settings → API. Required for auth + database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project settings → API → "service_role" secret key. Server-only, never
# exposed to the browser. Required for the Lemon Squeezy webhook to update
# a user's plan without a logged-in session.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (AI coach) ────────────────────────────────────────────────────
# Optional. Without it, /api/analyze uses the built-in heuristic coaching
# engine (services/ai/heuristic-provider.ts) — real scores and feedback
# computed from the transcript, no external API required. Set this to have
# gpt-4o-mini write the narrative feedback instead.
OPENAI_API_KEY=

# ── Lemon Squeezy (billing) ──────────────────────────────────────────────
# Settings → API → create an API key. Required for the "Upgrade to Pro"
# checkout flow.
LEMONSQUEEZY_API_KEY=
# Your store's numeric id (Settings → Stores).
LEMONSQUEEZY_STORE_ID=
# Settings → Webhooks → your endpoint → "Signing secret".
LEMONSQUEEZY_WEBHOOK_SECRET=
# Store → Products → the Pro plan's variant id (Products page, "Copy variant ID").
LEMONSQUEEZY_VARIANT_ID_PRO=
