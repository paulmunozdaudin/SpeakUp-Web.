{
  "name": "eloq-video",
  "private": true,
  "description": "Eloq TikTok ads: Remotion template + ElevenLabs voiceover.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice": "node scripts/voice.mjs",
    "voice-title": "node scripts/voice-title.mjs",
    "render": "node scripts/render.mjs",
    "promo": "remotion render src/index.ts Promo out/eloq-promo.mp4 --codec=h264 --crf=17",
    "promo:sfx-only": "remotion render src/index.ts Promo out/eloq-promo-sans-musique.mp4 --codec=h264 --crf=17 --props={\\\"music\\\":false,\\\"locale\\\":\\\"fr\\\"}",
    "promo:cover": "remotion still src/index.ts PromoCover out/eloq-promo-cover.png",
    "promo:audio": "python3 scripts/make-promo-audio.py",
    "promo:capture": "node scripts/capture-promo.cjs",
    "promo:es": "remotion render src/index.ts PromoEs out/eloq-promo-es.mp4 --codec=h264 --crf=17",
    "promo:es:sfx-only": "remotion render src/index.ts PromoEs out/eloq-promo-es-sin-musica.mp4 --codec=h264 --crf=17 --props={\\\"music\\\":false,\\\"locale\\\":\\\"es\\\"}",
    "promo:es:cover": "remotion still src/index.ts PromoCoverEs out/eloq-promo-es-portada.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/media-utils": "^4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
